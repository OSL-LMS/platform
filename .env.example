# Copia este archivo a .env.local y rellena los valores.
# Todas estas claves viven SOLO en el servidor — nunca con prefijo NEXT_PUBLIC_.

# Clave de la API de Anthropic (tutor IA). Solo servidor.
ANTHROPIC_API_KEY=sk-ant-...

# Cadena de conexión a la Postgres. En Railway la inyecta el plugin de Postgres
# automáticamente; en local apunta a tu base de datos de desarrollo.
DATABASE_URL=postgres://usuario:password@localhost:5432/tutor

# Qué currículo sirve esta instancia. OBLIGATORIA y SIN DEFECTO: un defecto
# "contextia" dejaría un literal de Contextia dentro de src/ y haría que un
# entorno mal configurado seleccionara Contextia en silencio en vez de fallar.
# Es configuración de SERVIDOR: nunca se deriva del request. Ojo: la columna
# `curriculum` permite varios currículos en una misma base, pero NO hay control
# de acceso entre ellos.
CURRICULUM_SLUG=contextia

# Base de datos DESECHABLE para `node scripts/check-curriculum-load.ts`. Esas
# comprobaciones escriben, borran subárboles y exigen la tabla vacía: el script
# aborta si esta variable falta, y también si apunta a la misma base que
# DATABASE_URL. Nunca la de producción.
CURRICULUM_TEST_DATABASE_URL=postgres://usuario:password@localhost:5432/tutor_test

# Secreto de Auth.js para firmar/cifrar sesiones y tokens. Genera uno con:
#   npx auth secret    (o: openssl rand -base64 33)
AUTH_SECRET=reemplaza-con-un-secreto-aleatorio

# Clave de la API de Resend para enviar el magic link (enlace de acceso).
# Auth.js la detecta como AUTH_RESEND_KEY; aceptamos también RESEND_API_KEY.
AUTH_RESEND_KEY=re_...

# PostHog (telemetría del embudo: registro → primer mensaje → pago).
# Es la clave de PROYECTO (phc_...), no una personal. Si falta, la telemetría
# es un no-op silencioso: la app funciona igual.
POSTHOG_API_KEY=phc_...
# US: https://us.i.posthog.com (por defecto) · EU: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# PostHog en el navegador (24 jul 2026): misma clave de proyecto, pero con
# prefijo NEXT_PUBLIC_ porque el cliente la necesita (no es un secreto: es la
# clave pública de ingesta). Solo se usa si el visitante ACEPTA el banner de
# cookies. Debe existir EN TIEMPO DE BUILD (Railway: variables del servicio).
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
