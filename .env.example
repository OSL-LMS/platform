# Copia este archivo a .env.local y rellena los valores.
# Todas estas claves viven SOLO en el servidor — nunca con prefijo NEXT_PUBLIC_.

# Clave de la API de Anthropic (tutor IA). Solo servidor.
ANTHROPIC_API_KEY=sk-ant-...

# Cadena de conexión a la Postgres. En Railway la inyecta el plugin de Postgres
# automáticamente; en local apunta a tu base de datos de desarrollo.
DATABASE_URL=postgres://usuario:password@localhost:5432/tutor

# Qué currículo sirve esta instancia. OBLIGATORIA y SIN DEFECTO: un defecto
# "contextia" dejaría un literal de Contextia dentro de src/ y haría que un
# entorno mal configurado seleccionara Contextia en silencio en vez de fallar.
# Es configuración de SERVIDOR: nunca se deriva del request. Ojo: la columna
# `curriculum` permite varios currículos en una misma base, pero NO hay control
# de acceso entre ellos.
CURRICULUM_SLUG=contextia

# Base de datos DESECHABLE para `node scripts/check-curriculum-load.ts`. Esas
# comprobaciones escriben, borran subárboles y exigen la tabla vacía: el script
# aborta si esta variable falta, y también si apunta a la misma base que
# DATABASE_URL. Nunca la de producción.
CURRICULUM_TEST_DATABASE_URL=postgres://usuario:password@localhost:5432/tutor_test

# Secreto de Auth.js para firmar/cifrar sesiones y tokens. Genera uno con:
#   npx auth secret    (o: openssl rand -base64 33)
AUTH_SECRET=reemplaza-con-un-secreto-aleatorio

# Clave de la API de Resend para enviar el magic link (enlace de acceso).
# Auth.js la detecta como AUTH_RESEND_KEY; aceptamos también RESEND_API_KEY.
AUTH_RESEND_KEY=re_...

# PostHog (telemetría del embudo: registro → primer mensaje → pago).
# Es la clave de PROYECTO (phc_...), no una personal. Si falta, la telemetría
# es un no-op silencioso: la app funciona igual.
POSTHOG_API_KEY=phc_...
# US: https://us.i.posthog.com (por defecto) · EU: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# PostHog en el navegador (24 jul 2026): misma clave de proyecto, pero con
# prefijo NEXT_PUBLIC_ porque el cliente la necesita (no es un secreto: es la
# clave pública de ingesta). Solo se usa si el visitante ACEPTA el banner de
# cookies. Debe existir EN TIEMPO DE BUILD (Railway: variables del servicio).
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- PRD-003 (fase 1): puente de acceso hacia apps/api ---------------------
# Ver specforge/003-phase-1-api-acceso-y-cobro.md y docs/SYSTEM_ARTIFACT.md
# (dominio `acceso`).

# URL base del servicio apps/api (NestJS). Es configuración de SERVIDOR: nunca
# se deriva del request (mismo patrón que CURRICULUM_SLUG arriba) — derivarla
# del Host o de una cabecera de proxy sería SSRF con exfiltración de la cookie
# de sesión del estudiante en el mismo movimiento.
API_BASE_URL=http://localhost:3001

# Apaga/enciende el puente hacia apps/api. Por defecto APAGADO ("true" para
# encender): con el flag apagado, /chat y /api/chat siguen usando
# src/lib/access.ts exactamente como hoy. Se enciende en el paso 3 de la
# migración (PRD-003 §10).
ACCESS_VIA_API=false

# Nombre de la cookie de sesión de Auth.js que se reenvía como Bearer al
# puente. OBLIGATORIA y SIN DEFECTO: Auth.js elige el prefijo __Secure- según
# el PROTOCOLO de la petición (vía X-Forwarded-Proto, con trustHost: true en
# src/auth.config.ts), no según NODE_ENV — apps/api no puede ver ese protocolo
# para replicar el criterio, así que cualquier valor por defecto sería una
# conjetura. Debe ser "authjs.session-token" o "__Secure-authjs.session-token".
AUTH_COOKIE_NAME=authjs.session-token

# Milisegundos que src/lib/api-client.ts espera a apps/api antes de degradar.
# Por defecto 2000 si se omite. Sin esto, un apps/api que acepta la conexión y
# no responde (reinicio, pool agotado) colgaría el render de /chat.
ACCESS_TIMEOUT_MS=2000

# Sal propia del píxel anónimo de /api/t — YA NO reutiliza AUTH_SECRET
# (PRD-003 §8: ese secreto pasa a vivir en dos servicios y su radio de
# explosión creció). Falla CERRADO: sin ella el píxel no emite. Nunca `?? ""`
# aquí — sería alcanzable (a diferencia del respaldo de hoy sobre AUTH_SECRET,
# inalcanzable porque sin AUTH_SECRET no hay login) y cualquiera reproduciría
# el hash sin conocer ningún secreto.
ANALYTICS_SALT=reemplaza-con-un-secreto-aleatorio

# Controla si el webhook de Paddle EN NEXT emite track() de
# subscription_activated/subscription_canceled. Por defecto ENCENDIDO
# (cualquier valor salvo "false"). Se apaga en el paso 4 de la migración
# (PRD-003 §10) al activar el segundo destino de Paddle hacia apps/api, para
# no duplicar el evento en el embudo mientras conviven los dos webhooks.
PADDLE_TRACK_ENABLED=true
