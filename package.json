{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "description": "App web del tutor IA socrático (v0). Chat sobre Claude Sonnet 4.6 con el system prompt certificado.",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "curriculum:load": "node scripts/load-curriculum.ts",
    "curriculum:check": "node scripts/check-curriculum-golden.ts && node scripts/check-curriculum.ts && node scripts/check-lessons.ts && node scripts/check-schedule.ts && node scripts/check-curriculum-identity.ts && node scripts/check-curriculum-load.ts",
    "test": "pnpm --filter api test",
    "check:access": "node scripts/check-access-bridge.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.0",
    "@auth/drizzle-adapter": "^1.11.2",
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "catalog:",
    "drizzle-orm": "catalog:",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.31",
    "pg": "catalog:",
    "posthog-js": "^1.407.2",
    "posthog-node": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.0"
  }
}
